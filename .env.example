# Copy to .env and fill in. Nothing here is read unless you run without --offline.

LLM_PROVIDER=azure_openai

# Azure OpenAI. The deployment name is what you called it in the portal, which
# is how you switch models without touching code - deploy another one and change
# this line.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Or talk to OpenAI directly: set LLM_PROVIDER=openai and fill these instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Findings are two or three sentences. Output tokens dominate the cost of this
# workload, so the limit is enforced here rather than asked for in the prompt.
LLM_MAX_NARRATION_TOKENS=700
